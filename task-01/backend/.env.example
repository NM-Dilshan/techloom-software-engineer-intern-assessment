# For local development with H2 (in-memory): leave these commented or empty
# For PostgreSQL/Supabase: uncomment and fill in your credentials

# PostgreSQL Example (for Supabase):
# DB_URL=jdbc:postgresql://db.your-project-ref.supabase.co:5432/postgres
# DB_USERNAME=postgres
# DB_PASSWORD=your-database-password
# DB_DRIVER_CLASS=org.postgresql.Driver
# DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect

# Default (H2 in-memory for local dev - no config needed)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Optional: to access H2 console during local dev
# http://localhost:8080/h2-console
# Driver: org.h2.Driver
# JDBC URL: jdbc:h2:mem:testdb
# User: sa
# Password: (leave empty)
