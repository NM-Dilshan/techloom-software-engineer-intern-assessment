# Local defaults use H2 when DB_* variables are omitted.
# For Supabase, replace every placeholder with values from Supabase Connect.
DB_URL=jdbc:postgresql://your-pooler-host:5432/postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=replace-with-local-secret
DB_DRIVER_CLASS=org.postgresql.Driver
DDL_AUTO=update
PORT=8080
FRONTEND_URL=http://localhost:5173
