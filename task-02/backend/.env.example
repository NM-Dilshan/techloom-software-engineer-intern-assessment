# Local development uses H2 automatically when these values are blank.
# For Supabase, copy the JDBC connection details from Supabase Connect.
DB_URL=jdbc:postgresql://your-pooler-host:5432/postgres
DB_USERNAME=postgres.your-project-ref
DB_PASSWORD=replace-with-local-secret
DB_DRIVER_CLASS=org.postgresql.Driver
DDL_AUTO=update
PORT=8082
FRONTEND_URL=http://localhost:5174